<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Sentinel Pipeline Security Report</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; line-height: 1.5; }
    .summary { padding: 18px; border: 1px solid #ddd; border-radius: 10px; }
    .finding { margin-top: 18px; padding: 18px; border: 1px solid #ddd; border-radius: 10px; }
    .meta { font-size: 0.95rem; }
    code { background: #f5f5f5; padding: 2px 5px; }
  </style>
</head>
<body>
  <h1>Sentinel Pipeline Security Report</h1>

  <div class="summary">
    <h2>Policy Decision: {{ decision.decision }}</h2>
    <p>Maximum risk score: {{ decision.max_risk_score }}</p>
    {% if decision.reasons %}
      <ul>
        {% for reason in decision.reasons %}
          <li>{{ reason }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  {% for f in findings %}
    <div class="finding">
      <h3>{{ f.title }}</h3>
      <div class="meta">
        <strong>Scanner:</strong> {{ f.scanner }} |
        <strong>Type:</strong> {{ f.finding_type }} |
        <strong>Severity:</strong> {{ f.severity }} |
        <strong>Risk:</strong> {{ f.risk_score }}
      </div>
      <p><strong>Asset:</strong> <code>{{ f.asset }}</code></p>
      <p>{{ f.description }}</p>
      <p><strong>Remediation:</strong> {{ f.remediation }}</p>
    </div>
  {% endfor %}
</body>
</html>
